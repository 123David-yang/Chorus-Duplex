LLM_API_KEY=
# Remote LLM endpoints require HTTPS. Loopback-only HTTP is allowed for local inference.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional overrides. Defaults use the bundled runtime and downloaded assets.
# DUPLEX_RESOURCES_DIR=/path/to/resources
# MOSS_DIR=/path/to/trusted/moss-runtime
# MOSS_MODEL_DIR=/path/to/moss-models
# VAD_MODEL=/path/to/silero-vad.onnx
# BG_SOURCE_DIR=/path/to/voices-babble
# VOICE_MANIFEST=/path/to/licensed-voice-manifest.json
# Optional extra LLM call for a locally flagged case; not a safety guarantee.
# CHORUS_TARGETED_SAFETY_REVIEW=1
